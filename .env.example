# Copy to .env, then fill these three values locally. Never commit .env.
CONTROL_PLANE_TUNNEL_ID=tunnel_your_id
CONTROL_PLANE_API_KEY=
GEMINI_API_KEY=

# Optional: path to an existing settings file, relative to compose.yaml or absolute.
GEMINI_FILESEARCH_SETTINGS_FILE=./config/settings.json

# Optional: on Linux, use the owner of the settings file (id -u / id -g).
# DOCKER_UID=1000
# DOCKER_GID=1000
